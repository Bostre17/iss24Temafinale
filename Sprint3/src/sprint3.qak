//cambiamenti al robot per limitare comunicazione con wis, passo at incinerator senza variabile X ma solo per conferma.
//giusto per comunicare che l'azione è  stata effettuata
//se arriva un nuovo lavoro lo esegue subito senza tornare a casa
//tolto pos da home e tolta logica si conferma engage secondo me ridondante
//dall'incenerator può effettuare altri ordini in coda senza incepparsi aggiungendo condizioni in t4
*/
//--------------------------OpRobot-----------------------------

QActor oprobot context ctxwis {
	[#
		val pos: MutableMap<String, Array<String>> = mutableMapOf()
	    pos["home"] = arrayOf("0", "0")
	    pos["burnin"] = arrayOf("2", "1")
	    pos["burnout"] = arrayOf("4", "3")
		pos["ashout"] = arrayOf("5", "4")
		pos["wastein"] = arrayOf("0", "4")
		
		var Job=""
		var X = 0
		var Y = 0
		
		var X_next = 0
		var Y_next = 0
	#]
    

    State s0 initial {
        println("[$name] inizializzazione.") color green
        request basicrobot -m engage : engage(name, 330)
    }
    Transition t0 whenReply engagedone -> standby
    
    State standby {
        println("[$name] pronto e in attesa in HOME.") color green
        [# 
        	Job = "waitingHome" 
        	X = pos["home"]!!.get(0).toInt()
        	Y = pos["home"]!!.get(0).toInt()
        #]
        emit position : position($X,$Y,$Job)
    }
    Transition t1 whenRequest bringRP -> goWasteIn
                  whenRequest bringAsh -> goBurnOut
    
    State goWasteIn {
        println("[$name] vado in WasteIn.") color green
        [# 
        	X_next = pos["wastein"]!!.get(0).toInt()
        	Y_next = pos["wastein"]!!.get(1).toInt()
        	Job = "goWasteIn" 
        #]
        emit position : position($X,$Y,$Job)
        delay 1000
        request basicrobot -m moverobot : moverobot($X_next, $Y_next)
    } 
    Transition t2 whenReply moverobotdone -> goBurnIn
                  whenReply moverobotfailed -> goHome

    State goBurnIn {
        println("[$name] arrivato in WasteIn, vado in BurnIn.") color green
        [# 
        	X = X_next
        	Y = Y_next
        	Job = "goBurnIn"
        #]
        emit position : position($X,$Y,$Job)
        delay 1000
        forward scale -m rpTaken : rpTaken(1)
        [# 
        	X_next = pos["burnin"]!!.get(0).toInt()
        	Y_next = pos["burnin"]!!.get(1).toInt()
        #]
        request basicrobot -m moverobot : moverobot($X_next,$Y_next)
    } 
    Transition t3 whenReply moverobotdone -> arrivedToIncinerator
                  whenReply moverobotfailed -> goHome
    
    State arrivedToIncinerator {
        println("[$name] sono arrivato all'inceneritore e notifico.") color green
        [# 
        	X = X_next
        	Y = Y_next
        	Job = "arrivedToIncinerator" 
        #]
        emit position : position($X,$Y,$Job)
        delay 1000
        replyTo bringRP with atIncinerator : atIncinerator(1)
    }
    Transition t4 whenMsg goHome -> goHome
                  whenRequest bringAsh -> goBurnOut
                  whenRequest bringRP -> goWasteIn

   	State goHome {
   		if [# Job != "waitingHome"#] {
        	println("[$name] vado in HOME.") color green
        	[# 
        		X = X_next
        		Y = Y_next
        		Job = "goHome"
        		
        		X_next = pos["home"]!!.get(0).toInt()
        		Y_next = pos["home"]!!.get(1).toInt() 
        	#]
        	emit position : position($X,$Y,$Job)
        	delay 1000
        	request basicrobot -m moverobot : moverobot($X_next,$Y_next)
    	} else {
        	println("[$name] sono gia' in HOME.") color green
    	}
    // Se è già in HOME, deve comunque passare a standby per accettare nuovi comandi
    // Lo facciamo con un 'Goto' incondizionato DENTRO l'else.
   	}
  	Goto standby if [# Job == "Waiting Home" #] else waitForReply

   //stato intermedio per attendere la risposta perchè sennò può essere che non va in standby
	State waitForReply{
  		println("[$name] In attesa di arrivare a HOME...") color green
  	}
	Transition t5 	whenReply moverobotdone -> standby
              		whenReply moverobotfailed -> goHome
                  
    State goBurnOut {
        println("[$name] vado a prelevare le ash in BurnOut.") color green
        [# 
        	X = X_next
        	Y = Y_next
        	Job = "goBurnOut" 
        	
        	X_next = pos["burnout"]!!.get(0).toInt() 
        	Y_next = pos["burnout"]!!.get(1).toInt() 
        #]
        emit position : position($X,$Y,$Job)
        delay 1000
        request basicrobot -m moverobot : moverobot($X_next,$Y_next)
    }
    Transition t6 whenReply moverobotdone -> goAshOut
                  whenReply moverobotfailed -> goHome
    
    State goAshOut {
        println("[$name] arrivato in BurnOut, vado a depositare in AshOut.") color green
        [# 
        	X = X_next
        	Y = Y_next
        	Job = "goAshOut"
        	
        	X_next = pos["ashout"]!!.get(0).toInt() 
        	Y_next = pos["ashout"]!!.get(1).toInt()
        	 
        #]
        emit position : position($X,$Y,$Job)
        delay 1000
        request basicrobot -m moverobot : moverobot($X_next,$Y_next)
    }
    Transition t7 whenReply moverobotdone -> atAshStorage
                  whenReply moverobotfailed -> goHome
    
    State atAshStorage {
        println("[$name] arrivato in AshStorage, deposito e notifico.") color green
        [# 
        	X = X_next 
        	X = Y_next
        	Job = "atAshStorage"
        #]
        emit position : position($X,$Y,$Job)
        delay 1000
        //forward sonarmock -m newAsh : newAsh(1)
        replyTo bringAsh with ashDeposited : ashDeposited(1)
    }
    Transition t8 whenMsg goHome -> goHome
                  whenRequest bringRP -> goWasteIn
}


//--------------------------WIS-----------------------------

QActor wis context ctxwis {
	[#
	val DLIMT = 40
	var wasteStorageWeight=0
	var ashStorageFull = 1
	var posX = 0
	var posY = 0
	var incinerator = 0
	var job = ""
	var RP=0
	#]
	
	
    State s0 initial {
        println("[$name] Initializing system") color green
        delay 15000
        subscribeTo incinerator for burnEnd 
		subscribeTo scale for stateScale
		
		//subscribeTo oprobot for position
		
        //le variabili inviate devono essere TUTTE MAIUSCOLE e raggruppare in ricezione con onMsg()
        forward incinerator -m act : act(2)
        println("[$name] sent act to incinerator") color green
        
		forward monitoringdevice -m sonarstart : sonarstart($DLIMT) 
        println("[$name] sent sonarstart to monitoringdevice") color green
        [# incinerator = 2 #]
    }
    Goto waitingRP


    State waitingRP {
        println("[$name] waiting for RP") color green
        forward oprobot -m goHome : goHome(X)
        println("[$name] inviato goHome ad oprobot.") color green
    }
	Transition t0
		whenEvent stateScale -> verifyCondition
		whenEvent stateSonar -> verifyCondition
	
	
	State verifyCondition{
		printCurrentMessage
		println("[$name] RP=$RP, incineratorState=$incinerator, ashStorageFull=$ashStorageFull") color green
		onMsg( stateSonar : stateSonar(X)){
			[# ashStorageFull = payloadArg(0).toInt() #]
			println("[$name] nuovo stato ash storage: $ashStorageFull") color green
			
			// se ashstorage è pieno e incinerator BURN allora il led lampeggia.
			if [# ashStorageFull == 1 && incinerator == 2#]
			{
        		forward monitoringdevice -m ledBlink : ledBlink(X)
				println("[$name] invio ledBlink a monitoringdevice") color green
			}
			else
			{
				//si deve controllare se l'ashstorage viene svuotato mentre si sta incenerendo.
				if [# incinerator == 1#]{
        			forward monitoringdevice -m ledOn : ledOn(X)
					println("[$name] invio ledOn a monitoringdevice") color green
				}
				else
				{
        			forward monitoringdevice -m ledOff : ledOff(X)
					println("[$name] invio ledOff a monitoringdevice") color green
				}
			}
		}
		onMsg( stateScale : stateScale(X)){
			[# 	wasteStorageWeight = payloadArg(0).toInt() 
				 RP = wasteStorageWeight/50 #]
			println("[$name] RP quantity: $RP") color green
		}
	}
	Goto startRoutine if [#RP>0 && incinerator!=1 && ashStorageFull == 0 #] else waitingRP
			
    
    
    
    State startRoutine{
    	println("[$name] start routine") color green
    	request oprobot -m bringRP : bringRP(X)
    }
    Transition t0
    	whenReply atIncinerator -> startIncinerator
		whenInterruptEvent stateScale -> handleStateScale
		whenInterruptEvent stateSonar -> handleStateSonar
		//whenInterruptEvent position -> handleRobotPosition
		
    
    State startIncinerator{
        println("[$name] Incinerator started") color green
        forward monitoringdevice -m ledOn : ledOn(X)
        forward incinerator -m notifyRp : notifyRp(X)
        // il robot potrebbe tornare in home da solo senza comando del wis, però se non facessi così tornerebbe ad home istantaneamente, senza scaricare RP (su controllo del WIS)
        forward oprobot -m goHome : goHome(X)
        [# incinerator = 1#]
	}
	Transition t0
		whenEvent burnEnd -> endIncinerator
		whenInterruptEvent stateScale -> handleStateScale
		whenInterruptEvent stateSonar -> handleStateSonar
		//whenInterruptEvent position -> handleRobotPosition
	
	State endIncinerator{
        println("[$name] incinerator is now idle") color green
        forward monitoringdevice -m ledOff : ledOff(X)
        request oprobot -m bringAsh : bringAsh(X)
    	[# 
    		incinerator = 2
    	#]

	}
	Transition t0
		whenReply ashDeposited -> verifyCondition
		whenInterruptEvent stateScale -> handleStateScale
		//whenInterruptEvent stateSonar -> handleStateSonar
		//whenInterruptEvent position -> handleRobotPosition
    
    
    //State handleStateIncinerator {
    //    onMsg( stateIncinerator : stateIncinerator(X)){
	//		[# incinerator = payloadArg(0).toInt() #]
	//		println("Incinerator state (Off = 0, On = 1, Idle = 2): $incinerator") color green
	//	}
	//	returnFromInterrupt
    //}
    
    State handleStateSonar {
        onMsg( stateSonar : stateSonar(X)){
			[# ashStorageFull = payloadArg(0).toInt() #]
			println("[$name] Ash storage level: $ashStorageFull") color green
			// se ashstorage è pieno allora il led lampeggia.
			if [# ashStorageFull == 1 #]
			{
				forward monitoringdevice -m ledBlink : ledBlink(X)
			}
			else
			{
				//si deve controllare se l'ashstorage viene svuotato mentre si sta incenerendo.
				if [# incinerator == 1#]{
					forward monitoringdevice -m ledOn : ledOn(X)
				}
				else
				{
        			forward monitoringdevice -m ledOff : ledOff(X)
				}
			}
		}
		returnFromInterrupt
    }
    
    State handleStateScale {
        onMsg( stateScale : stateScale(X)){
			[# 	wasteStorageWeight = payloadArg(0).toInt() 
				RP = wasteStorageWeight/50 #]
			println("[$name] RP quantity updated: $RP") color green
		}
		returnFromInterrupt
    }
    /* 
    State handleRobotPosition {
        onMsg( position : position(X,Y)){
			[# 	posX = payloadArg(0).toInt()
				posY = payloadArg(1).toInt() 
				job = payloadArg(2)
			#]
			println("[$name] OpRobot   position $posX $posY   routine $job") color green
		}
		returnFromInterrupt
    }
    */
    
    
}